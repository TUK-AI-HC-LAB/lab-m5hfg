+        def _batched_search(search_index, features, batch_size=128):
+            """Search in small query batches to limit FAISS CPU peak memory."""
+            distances, indices = [], []
+            for start_idx in range(0, len(features), batch_size):
+                batch = np.ascontiguousarray(features[start_idx : start_idx + batch_size])
+                batch_distances, batch_indices = search_index.search(batch, n_nearest_neighbours)
+                distances.append(batch_distances)
+                indices.append(batch_indices)
+            return np.concatenate(distances, axis=0), np.concatenate(indices, axis=0)
+
         if index_features is None:
-            return self.search_index.search(query_features, n_nearest_neighbours)
